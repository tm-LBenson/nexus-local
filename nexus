#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAUNCHER="$ROOT_DIR/scripts/nexus.ps1"

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$LAUNCHER" "$@"
fi

cat >&2 <<'EOF'
PowerShell 7+ is required to run the Nexus Local launcher on Linux/macOS.

Install pwsh, then run:
  ./nexus

Fedora/Nobara usually uses Microsoft's RPM repo for PowerShell packages.
See: https://learn.microsoft.com/powershell/scripting/install/install-rhel
EOF
exit 127
