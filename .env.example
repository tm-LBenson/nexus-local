APP_ENV=local
HTTP_ADDR=:8080
APP_VERSION=dev
CORS_ALLOWED_ORIGIN=http://localhost:5173
PERSISTENCE_BACKEND=postgres
RUN_MIGRATIONS=true

DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=documents
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=hash-embedding
EMBEDDING_DIMENSIONS=384
VECTOR_BACKEND=qdrant
VECTOR_BASE_URL=http://qdrant:6333
VECTOR_COLLECTION=documents
VECTOR_API_KEY=
QUEUE_BACKEND=nats
QUEUE_URL=nats://nats:4222
CACHE_URL=redis://valkey:6379/0

MODEL_GATEWAY_BASE_URL=http://model-gateway:8000/v1
MODEL_GATEWAY_API_KEY=
DEFAULT_MODEL_TARGET=general
GENERAL_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
WORKER_POLL_INTERVAL=2s
