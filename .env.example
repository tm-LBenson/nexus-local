APP_ENV=local
HTTP_ADDR=:8080
APP_VERSION=dev
CORS_ALLOWED_ORIGIN=http://localhost:5173
AUTH_MODE=dev
DEV_USER_ID=user_1
DEV_USER_EMAIL=dev@example.local
TRUSTED_USER_ID_HEADER=X-User-ID
TRUSTED_EMAIL_HEADER=X-User-Email
PERSISTENCE_BACKEND=postgres
RUN_MIGRATIONS=true

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable
OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=documents
EMBEDDING_RUNTIME=none
EMBEDDING_BACKEND=hash
EMBEDDING_BASE_URL=http://host.docker.internal:8082/v1
EMBEDDING_API_KEY=
EMBEDDING_GATEWAY_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
EMBEDDING_GATEWAY_PORT=8082
EMBEDDING_MODEL=hash-embedding
EMBEDDING_DIMENSIONS=384
VECTOR_BACKEND=qdrant
VECTOR_BASE_URL=http://qdrant:6333
VECTOR_COLLECTION=documents
VECTOR_API_KEY=
QUEUE_BACKEND=nats
QUEUE_URL=nats://nats:4222
CACHE_URL=redis://valkey:6379/0

PROVIDER_PRESET=starter
MODEL_GATEWAY_BASE_URL=http://model-gateway:8000/v1
MODEL_GATEWAY_API_KEY=
DEFAULT_MODEL_TARGET=general
GENERAL_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HUGGING_FACE_HUB_TOKEN=
WORKER_POLL_INTERVAL=2s

# Web image build-time API base for the local CPU profile.
VITE_API_BASE_URL=http://localhost:8080

# Production auth profile.
# Caddy serves the app and proxies API calls to /api.
NEXUS_PUBLIC_URL=http://localhost:8088
NEXUS_SITE_ADDRESS=:80
NEXUS_HTTP_PORT=8088
NEXUS_HTTPS_PORT=8443
WEB_API_BASE_URL=/api

# Internal URL for an Authelia-compatible forward-auth gateway.
# The gateway should return Remote-User and Remote-Email after login.
AUTHELIA_INTERNAL_URL=http://authelia:9091
